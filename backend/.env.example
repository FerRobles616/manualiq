ENVIRONMENT=development
DATABASE_URL=sqlite:///./manualiq.db
EMBEDDING_PROVIDER=model2vec
EMBEDDING_MODEL=minishlab/potion-multilingual-128M
EMBEDDING_DIM=256
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.30
FTS_LANGUAGE=english
INGESTION_MODE=sync
WORKER_POLL_SECONDS=2.0
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_SECONDS=900
UPLOAD_DIR=./data/uploads
CORPUS_DIR=./data/corpus
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=*

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://manualiq:manualiq@localhost:5432/manualiq
